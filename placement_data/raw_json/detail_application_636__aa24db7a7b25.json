{"status":"success","message":null,"data":{"responsibilities":null,"overview":null,"locations":"Bangalore/ Chennai/ Pune/ Mumbai/ Gurgaon","processCompleted":false,"deleted":false,"mailPublished":true,"newCompany":false,"dream":false,"notificationMuted":true,"applied":false,"studentOopsOrFrozen":false,"modifyAllowed":false,"withdrawAllowed":false,"withdrawalDeadlineSameAsApplicationDeadline":false,"displayNameSameAsCompanyName":true,"includedInApplicationMatrix":false,"application_detail_id":3600,"application_id":636,"application_status_id":3,"placement_process_id":44,"batch_group_id":0,"batch_group_ids":"[59, 60]","dayslot_id":0,"cluster_id":0,"cluster_sequence_number":0,"job_function_id":0,"uuid":"1cdfddf2-eaad-4b8a-aa53-e09798209670","sector_id":25,"company_id":666,"max_roles_to_be_applied":null,"company_name":"Citigroup","job_title":"Trainee Data Scientist","sector_label":"Banking","other_sector":"","max_roles":0,"job_summary":"","job_function":"","job_description":"","process_name":"FT 2025-26","batch_group_label":"","skills":"Essential Skills (Technical)\nProgramming: Foundational knowledge in Python (Pandas, NumPy, Scikit-learn) or R.\nDatabase Skills: Basic understanding of SQL for data extraction and manipulation.\nStatistical Concepts: Solid understanding of basic statistical concepts (e.g., hypothesis testing, regression).\nData Visualization: Familiarity with data visualization tools/libraries (e.g., Matplotlib, Seaborn, Tableau, Power BI).\nMachine Learning Basics: Conceptual understanding of common machine learning algorithms (e.g., Linear Regression, Logistic Regression, Decision Trees).\nDevelopment of  search techniques / esp. semantic search\nDevelopment of solutions using  RAG framework for building Gen AI solutions\nDevelopment of Agentic solution using frameworks like Langchain / Google Agent space, etc\nEssential Skills (Soft)\nProblem-Solving: Strong analytical and problem-solving abilities.\nCommunication: Excellent verbal and written communication skills to explain technical concepts to non-technical audiences.\nLearning Agility: High curiosity and a strong desire to learn new technologies and methodologies.\nTeamwork: Ability to work effectively in a collaborative team environment.\nAttention to Detail: Meticulous approach to data handling and analysis.\nPreferred Qualifications (Optional but beneficial)\nExperience with version control systems (e.g., Git).\nFamiliarity with cloud platforms (e.g., AWS, Azure, GCP).\nExperience with big data technologies (e.g., Spark, Hadoop).\nParticipation in data science bootcamps, online courses, or personal projects/Kaggle competitions.","website_url":"https://www.citigroup.com/global/about-us/global-presence/india","eligibility_information":"CGPA 6 and above\nEducational Qualification\nBachelor's or master's degree in a quantitative field such as Computer Science, Statistics, Mathematics, Economics, Engineering, or a related discipline.","job_package":"","min_work_experience":0,"max_work_experience":0,"is_dream":false,"date_of_visit":null,"publish_time":1762233481000,"withdrawl_deadline":1762407000000,"application_deadline":1762407000000,"application_start_time":1762233600000,"additional_information":"Key Responsibilities&#10;<div>&#61623;Data Collection &amp; Cleaning: Assist in collecting, cleaning, and preprocessing large datasets to ensure data quality and integrity.&#10;</div><div>&#61623;Exploratory Data Analysis (EDA): Conduct basic exploratory data analysis to identify trends, patterns, and insights.&#10;</div><div>&#61623;Feature Engineering Support: Support the creation and selection of features for machine learning models.&#10;</div><div>&#61623;Model Development Assistance: Help in building, training, and evaluating basic machine learning models under guidance.&#10;</div><div>&#61623;Documentation: Maintain clear and concise documentation of data processes, models, and analytical findings.&#10;</div><div>&#61623;Collaboration: Work closely with senior data scientists, engineers, and business stakeholders.&#10;</div><div>&#61623;Learning &amp; Development: Actively participate in training programs, workshops, and self-study to enhance data science skills.&#10;</div><div>&#61623;Reporting: Assist in preparing reports and visualizations to communicate findings effectively.</div>","additional_details":null,"is_notification_muted":true,"is_withdrawal_same_as_application_deadline":false,"is_new_company":false,"is_display_name_same_as_company_name":true,"is_included_in_application_matrix":false,"display_name":"Citi Bank","is_published":true,"is_deleted":false,"is_process_completed":false,"created_by":9801,"created_by_name":"Poonam P","updated_by":8527,"created_at":1761060457000,"updated_at":1762233482000,"company_query":{"overview":null,"city":null,"state":null,"zip":null,"pan":null,"contacts":null,"sourceHistory":null,"placecoms":null,"approved":false,"company_id":666,"company_name":"Citigroup","source":null,"website_url":null,"logo":null,"industry":null,"address_line_1":null,"address_line_2":null,"is_approved":false,"is_disabled":false,"primary_placecoms":null,"secondary_placecoms":null,"created_by":8524,"updated_by":8524,"created_at":1760341820000,"updated_at":1760341820000},"questions":[],"documents":[{"documentName":null,"jd_document_id":726,"application_id":636,"document_id":8790,"user_id":9801,"document_type_id":5,"uuid":"749dd694-dc65-44eb-8c6a-4db3a7cdeae8","file_name":"Trainee Data Scientist","file_original_name":"FTE - JD_CITI - 2026 -.docx","file_extension":"docx","file_path":"/datadrive/iisc-files/skynet-v2-files/9801-9801","file_size":"39 KB","file_name_in_path":"1761060381157_FTE-JD_CITI-2026-.docx","file_link":"9801-9801/1761060381157_FTE-JD_CITI-2026-.docx","is_jd":true,"created_by":9801,"updated_by":9801,"created_at":1761060381000,"updated_at":1761060381000,"document_name":null}],"offer_letter_sample_copy":[],"applicant_status":null,"eligibility_message":"","job_roles":[{"deleted":fal