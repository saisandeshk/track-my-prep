{"status":"success","message":null,"data":{"responsibilities":null,"overview":null,"locations":"Gurgaon ","processCompleted":false,"deleted":false,"mailPublished":true,"newCompany":false,"dream":false,"notificationMuted":false,"applied":true,"studentOopsOrFrozen":false,"modifyAllowed":false,"withdrawAllowed":false,"withdrawalDeadlineSameAsApplicationDeadline":false,"displayNameSameAsCompanyName":true,"includedInApplicationMatrix":false,"application_detail_id":4128,"application_id":786,"application_status_id":3,"placement_process_id":44,"batch_group_id":0,"batch_group_ids":"[59, 60]","dayslot_id":0,"cluster_id":0,"cluster_sequence_number":0,"job_function_id":0,"uuid":"53f3368d-5f70-43fd-a0bd-0339ec76c19e","sector_id":20,"company_id":1241,"max_roles_to_be_applied":null,"company_name":"LAT Aerospace","job_title":"Engineer","sector_label":"Aerospace and Defense","other_sector":"","max_roles":0,"job_summary":"","job_function":"","job_description":"","process_name":"FT 2025-26","batch_group_label":"","skills":"All departments will be able to apply","website_url":"https://www.lat.com/","eligibility_information":"All departments will be able to apply","job_package":"","min_work_experience":0,"max_work_experience":0,"is_dream":false,"date_of_visit":null,"publish_time":1764059006000,"withdrawl_deadline":1764165667000,"application_deadline":1764165667000,"application_start_time":1764059400000,"additional_information":"<b>LAT Aerospace | Graduate Engineers</b><div>Location: Gurgaon (on-site test locations may apply)&#8232;</div><div>Type: Full-time | Entry-level</div><div><br></div><div>We&#8217;re hiring engineers who build first, ask later.</div><div><br></div><div>At LAT, we&#8217;re not just building an aircraft &#8211; we&#8217;re building a culture. One where the best ideas win, where speed matters more than perfection, and where engineers don&#8217;t wait for instructions&#8212;they chase breakthroughs.&#160;<span>We&#8217;re developing a new kind of short takeoff and landing (STOL) aircraft with a hybrid-electric powertrain. To do that, we&#8217;re putting together one of the most hands-on, high-agency engineering teams in the country.&#160;</span><span>If you&#8217;ve ever debugged a motor controller at 2 AM or reverse-engineered a problem no textbook could solve, you&#8217;ll fit right in.</span></div><div><br></div><div>Choose Your Track:</div><div><br></div><div><b>The Airshapers</b></div><div>- Shape aerodynamic performance, stability, and control&#8232;</div><div>- Build aero databases, validate CFD, wind tunnel, and flight test data</div><div><b>Thrustsmiths</b></div><div>- Design and model electric/hybrid propulsion systems&#8232;</div><div>- Integrate motors, batteries, cooling, and thermal protection</div><div><b>Signal Crew&#8232;</b></div><div>- Develop flight computers, data buses, and sensor networks&#8232;</div><div>- Build and test embedded avionics hardware</div><div><b>Autopilots&#8232;</b></div><div>- Design guidance laws and autopilot loops&#8232;</div><div>- Build estimators, filters, and sensor fusion pipelines</div><div><b>Firmware Forgers&#8232;</b></div><div>- Write low-level code for critical systems&#8232;</div><div>- Interface with sensors, actuators, and real-time controls</div><div><b>Loadbearers&#8232;</b></div><div>- Run FEA and stress analysis for airframe components&#8232;</div><div>- Design and validate composite structures</div><div><b>Builders' Guild&#8232;</b></div><div>- Develop tooling, jigs, and fast prototyping processes&#8232;</div><div>- Select and test aerospace-grade materials</div><div><br></div><div><b>Who you are&#8232;</b></div><div>- You don&#8217;t wait for permission to start solving problems&#8232;</div><div>- You&#8217;ve built more than simulations: rigs, drones, bikes, rockets&#8232;</div><div>- You can dive deep in one domain but jump across others when needed&#8232;</div><div>- You thrive in chaos and learn fast when things break</div><div><br></div><div><b>Bonus if you have&#8232;</b></div><div>- Built in student tech teams: UAV, FSAE, Rocketry, Hyperloop, Satellite, etc.&#8232;</div><div>- Tinkering experience: 3D printing, soldering, machining, hacking&#8232;</div><div>- Projects in Python, Simulink, MATLAB, C/C++, CAD, FEA, RTOS&#8232;Self-initiated builds, open-source contributions, or sub-team leadership</div><div><br></div><div><b>Why LAT?</b></div><div>- Core team opportunity at a high-conviction deep-tech startup</div><div>- Real aircraft, real flying hardware, real impact</div><div>- Build the future of sustainable aviation in India</div>","additional_details":null,"is_notification_muted":false,"is_withdrawal_same_as_application_deadline":false,"is_new_company":false,"is_display_name_same_as_company_name":true,"is_included_in_application_matrix":false,"display_name":"LAT Aerospace Private Limited","is_published":true,"is_deleted":false,"is_process_completed":false,"created_by":9928,"created_by_name":"Vrushali Kelkar","updated_by":8525,"created_at":1763632578000,"updated_at":1764160947000,"company_query":{"overview":null,"city":null,"state":null,"zip":null,"pan":null,"contacts":null,"sourceHistory":null,"placecoms":null,"approved":false,"company_id":1241,"company_name":"LAT Aerospace","source":"Existing Database","website_url":null,"logo":null,"industry":null,"address_line_1":null,"address_line_2":null,"is_approved":false,"is_disabled":false,"primary_placecoms":null,"secondary_placecoms":null,"created_by":9578,"updated_by":9939,"created_at":1763631489000,"updated_at":1769756369000},"questions":[],"documents":[{"documentName":null,"jd_document_id":839,"application_id":786,"document_id":14249,"user_id":9928,"document_type_id":5,"uuid":"22562a4f-2809-4f88-899a-d0a3b1ebd411","file_name":"Graduate Engineer","file_original_name":"LAT Aerospace _ Graduate Engineers.pdf","file_extension":"pdf","file_path":"/datadrive/iisc-files/skynet-v2-files/9928-9928","file_size":"38 KB","file_name_in_path":"1763632568142_LATAerospace_GraduateEng