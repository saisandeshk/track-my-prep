{"status":"success","message":null,"data":{"responsibilities":null,"overview":null,"locations":"Internship/Co-Op","processCompleted":false,"deleted":false,"mailPublished":true,"newCompany":false,"dream":false,"notificationMuted":true,"applied":false,"studentOopsOrFrozen":false,"modifyAllowed":false,"withdrawAllowed":false,"withdrawalDeadlineSameAsApplicationDeadline":false,"displayNameSameAsCompanyName":true,"includedInApplicationMatrix":false,"application_detail_id":5196,"application_id":1017,"application_status_id":3,"placement_process_id":44,"batch_group_id":0,"batch_group_ids":"[59, 60]","dayslot_id":0,"cluster_id":0,"cluster_sequence_number":0,"job_function_id":0,"uuid":"90b9178e-8032-4d11-b894-9d1d64c74bf3","sector_id":66,"company_id":529,"max_roles_to_be_applied":0,"company_name":"Analog Devices","job_title":"Device Modeling intern","sector_label":"VLSI and Semiconductors","other_sector":"","max_roles":0,"job_summary":"","job_function":"","job_description":"","process_name":"FT 2025-26","batch_group_label":"","skills":"Minimum Qualifications \n-\tM.Tech/ME degree emphasizing semiconductor devices, device models, and/or circuit design.\n-\tPursuing a Ph.D. in the field of Semiconductor Device Physics, Characterization, and Modeling\n-\tStrong analytical skills, execution mindset, and sense of urgency\nPreferred Qualifications \n-\tFamiliar with semiconductor device characterization\n-\tKnows Python, Verilog-A Programming \n","website_url":"https://www.analog.com/en/index.html","eligibility_information":"Pursuing a PhD in the field of semiconductor Device physics Characterization and Modelling","job_package":"","min_work_experience":0,"max_work_experience":0,"is_dream":false,"date_of_visit":null,"publish_time":1770029830000,"withdrawl_deadline":1770112579000,"application_deadline":1770112579000,"application_start_time":1770030009000,"additional_information":"What is the title of your internship? Device Modeling Intern&#10;<div>The Internship program at ADI provides young professionals with the opportunity to gain professional experience within an innovative and global company. ADI&#8217;s long-term goal is to convert an intern into a full-time employee. The University Relations Team continually strives to accomplish this goal year-after-year by establishing a well-equipped program (virtual and in person) that focuses on growth, company culture, and mentorship, coupled with a collaborative work environment and passion for innovation. On average, each year, ADI converts roughly 70%-80% of their interns into full time hires! &#10;</div><div>ADI provides a high-quality internship program for which the company has consistently been known. These events involve cross-collaboration with peers, including executive speakers, lab tours, development events, social events, and community service opportunities. Our Intern Program provides an opportunity for interns to collaborate and learn, drive results, and grow their professional network. Apply now for the opportunity to start your career and help innovate ahead of what&#8217;s possible!&#10;</div><div>The device modeling team is seeking a motivated, experienced device modeling intern to provide support to our Corporate Engineering Division located at ADI&#8217;s Bangalore, India. Our team has about 18 members in different ADI locations. We are talented engineers from diverse cultural backgrounds. Device modeling team is the bridge between the process team and circuit designers. We make career growth from both sides in ADI.&#10;</div><div>Responsibilities include, but are not limited to: &#10;</div><div>-&#9;Develop semiconductor device compact models for the SPICE simulator.&#10;</div><div>-&#9;Correlate the device compact model with measurement data. &#10;</div><div>-&#9;Resolve convergence issues during circuit simulation.&#10;</div><div>-&#9;Develop programming scripts to automate the extraction and report generation process.&#10;</div><div>-&#9;Make a comprehensive report to summarize his/her work.&#10;</div><div>Minimum Qualifications &#10;</div><div>-&#9;M.Tech/ME degree emphasizing semiconductor devices, device models, and/or circuit design.&#10;</div><div>-&#9;Pursuing a Ph.D. in the field of Semiconductor Device Physics, Characterization, and Modeling&#10;</div><div>-&#9;Strong analytical skills, execution mindset, and sense of urgency&#10;</div><div>Preferred Qualifications &#10;</div><div>-&#9;Familiar with semiconductor device characterization&#10;</div><div>-&#9;Knows Python, Verilog-A Programming</div><div>&#10;</div><div>&#10;</div>","additional_details":null,"is_notification_muted":true,"is_withdrawal_same_as_application_deadline":false,"is_new_company":false,"is_display_name_same_as_company_name":true,"is_included_in_application_matrix":false,"display_name":"Analog Devices","is_published":true,"is_deleted":false,"is_process_completed":false,"created_by":10660,"created_by_name":"Kugan P","updated_by":10660,"created_at":1770029668000,"updated_at":1770029830000,"company_query":{"overview":null,"city":null,"state":null,"zip":null,"pan":null,"contacts":null,"sourceHistory":null,"placecoms":null,"approved":false,"company_id":529,"company_name":"Analog Devices","source":"Existing Database","website_url":null,"logo":null,"industry":null,"address_line_1":null,"address_line_2":null,"is_approved":false,"is_disabled":false,"primary_placecoms":null,"secondary_placecoms":null,"created_by":8524,"updated_by":10660,"created_at":1760341820000,"updated_at":1784607821000},"questions":[],"documents":[{"documentName":null,"jd_document_id":977,"application_id":1017,"document_id":17310,"user_id":10660,"document_type_id":5,"uuid":"c064fb78-14f2-4c64-996c-64600e06d7f8","file_name":"Device Modeling intern","file_original_name":"FY26_IDC_Internship_Job_Description (002).docx","file_extension":"docx","file_path":"/datadrive/iisc-files/skynet-v2-files/10660-10660","file_size":"23 KB","file_name_in_path":"1770029764875_FY26_IDC_Internship_Job_Description002