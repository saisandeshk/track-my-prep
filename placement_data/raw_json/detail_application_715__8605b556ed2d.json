{"status":"success","message":null,"data":{"responsibilities":null,"overview":null,"locations":"Bangalore","processCompleted":false,"deleted":false,"mailPublished":true,"newCompany":false,"dream":false,"notificationMuted":true,"applied":false,"studentOopsOrFrozen":false,"modifyAllowed":false,"withdrawAllowed":false,"withdrawalDeadlineSameAsApplicationDeadline":false,"displayNameSameAsCompanyName":true,"includedInApplicationMatrix":false,"application_detail_id":4209,"application_id":715,"application_status_id":3,"placement_process_id":44,"batch_group_id":0,"batch_group_ids":"[59, 60]","dayslot_id":0,"cluster_id":0,"cluster_sequence_number":0,"job_function_id":0,"uuid":"49819a9a-9bc7-45f5-8cb9-ce00d9e00eb6","sector_id":30,"company_id":1206,"max_roles_to_be_applied":null,"company_name":"Havells India Limited","job_title":"PGET/Research Engineer-Power Electronics","sector_label":"Consumer Electronics","other_sector":"","max_roles":0,"job_summary":"","job_function":"","job_description":"","process_name":"FT 2025-26","batch_group_label":"","skills":"Please refer JD for more information","website_url":"www.havells.com","eligibility_information":"Minimum 60% throughout their academic from 10th Std to highest degree.  No backlogs are not allowed","job_package":"","min_work_experience":0,"max_work_experience":0,"is_dream":false,"date_of_visit":null,"publish_time":1762770395000,"withdrawl_deadline":1764642639000,"application_deadline":1764642639000,"application_start_time":1763065800000,"additional_information":"Job Summary:&#160;&#160;&#10;<div>We are seeking a talented Electronics Hardware Design Engineer to join our dynamic engineering team. The ideal candidate will have a strong background in electronics circuit and power Converter design, experience with circuitry and PCB layout, and a passion for innovation. As a Power Electronics Hardware Design Engineer, you will play a critical role in developing cutting-edge electronic products that meet our customers' needs and industry standards.&#160;&#10;</div><div>&#160;&#10;</div><div>Educational Qualifications and Key Skills:&#160;&#10;</div><div>Master's (M.E./MTech.) or Ph.D. degree in Electrical Engineering or Electronics Engineering discipline&#10;</div><div>Excellent problem-solving skills and the ability to work both independently and collaboratively in a team environment&#10;</div><div>Strong understanding of analog, digital electronics, signal processing, and microcontroller-based systems&#10;</div><div>Strong communication skills to convey complex technical concepts to both technical and non-technical stakeholders&#160;&#10;</div><div>Attention to detail and a passion for producing high-quality, reliable electronic products&#10;</div><div>Experience with testing and debugging electronic circuits using lab equipment (oscilloscopes, power supplies, Power analyzers, etc.).&#160;&#10;</div><div>Experience with embedded systems, firmware development (a plus).&#160;&#10;</div><div>Familiarity with simulation tools (e.g., PSPICE, MATLAB) and analysis techniques for electronics design.&#160;&#10;</div><div>Knowledge of PCB layout design and manufacturing processes, assembly, and fabrication techniques.&#160;&#10;</div><div>&#160;&#10;</div><div>&#160;Job Responsibilities, but not limited to:&#160;&#10;</div><div>Design and develop analog, digital and power electronic circuits for various applications, such as Motor drive Controller, LLC, PFC, Bi-directional Converters. Grid Tie Inverters etc.&#160;&#10;</div><div>Conducting design simulations and analyses to optimize circuit performance and ensure compliance with industry standards.&#160;&#10;</div><div>Ensuring system performance, reliability, and manufacturability while system design.&#160;&#10;</div><div>Create schematic diagrams and guide the PCB layout design team, considering factors such as thermal management, and EMI/EMC compliance.&#160;&#10;</div><div>Collaborate with cross-functional teams including software engineers, mechanical engineers, and product managers to define hardware requirements and specifications.&#160;&#10;</div><div>Built Prototype and test electronic circuits, identify and troubleshoot issues, and implement necessary design improvements.&#160;&#10;</div><div>Research and develop various Power converter topologies, select appropriate components, including microcontrollers, sensors, connectors, and other electronic parts, considering cost, availability, and performance.&#160;&#10;</div><div>Perform design validation and verification tests to ensure products meet design specifications and regulatory requirements.&#160;&#10;</div><div>Stay updated on industry trends, emerging technologies, and best practices in electronics design using GaN, SiC devices.</div>","additional_details":null,"is_notification_muted":true,"is_withdrawal_same_as_application_deadline":false,"is_new_company":false,"is_display_name_same_as_company_name":true,"is_included_in_application_matrix":false,"display_name":"Havells India Limited","is_published":true,"is_deleted":false,"is_process_completed":false,"created_by":9893,"created_by_name":"Satheesh Babu","updated_by":8524,"created_at":1761907599000,"updated_at":1764592136000,"company_query":{"overview":null,"city":null,"state":null,"zip":null,"pan":null,"contacts":null,"sourceHistory":null,"placecoms":null,"approved":false,"company_id":1206,"company_name":"Havells India Limited","source":null,"website_url":null,"logo":null,"industry":null,"address_line_1":null,"address_line_2":null,"is_approved":false,"is_disabled":false,"primary_placecoms":null,"secondary_placecoms":null,"created_by":8524,"updated_by":8524,"created_at":1761906111000,"updated_at":1761906111000},"questions":[],"documents":[],"offer_letter_sample_copy":[],"applicant_status":null,"eligibility_message":"","job_roles":[{"deleted":false,"published":true,"applied":false,"application_job_role_id":1011,"application_id":715,"job_role_id":690,"company_id":1206,"company_name":"Havells India Limi