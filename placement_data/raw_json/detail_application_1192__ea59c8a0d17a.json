{"status":"success","message":null,"data":{"responsibilities":null,"overview":null,"locations":"Bangalore","processCompleted":false,"deleted":false,"mailPublished":true,"newCompany":false,"dream":false,"notificationMuted":true,"applied":false,"studentOopsOrFrozen":false,"modifyAllowed":false,"withdrawAllowed":false,"withdrawalDeadlineSameAsApplicationDeadline":false,"displayNameSameAsCompanyName":true,"includedInApplicationMatrix":false,"application_detail_id":5956,"application_id":1192,"application_status_id":3,"placement_process_id":44,"batch_group_id":0,"batch_group_ids":"[59, 60]","dayslot_id":0,"cluster_id":0,"cluster_sequence_number":0,"job_function_id":0,"uuid":"3e784a8d-1f9c-4d84-9677-7ad279db73c8","sector_id":57,"company_id":1696,"max_roles_to_be_applied":0,"company_name":"Ericsson Global India Services","job_title":"Graduate Engineer Trainee","sector_label":"Telecommunications","other_sector":"","max_roles":0,"job_summary":"","job_function":"","job_description":"","process_name":"FT 2025-26","batch_group_label":"","skills":"VLSI","website_url":"https://internal.ericsson.com/","eligibility_information":"Electronics and related branches-,75% - X & XII & >= 6.5 CGPA – MTech","job_package":"","min_work_experience":0,"max_work_experience":0,"is_dream":false,"date_of_visit":null,"publish_time":1774850385000,"withdrawl_deadline":1775017800000,"application_deadline":1775017800000,"application_start_time":1774850597000,"additional_information":"About this opportunity&#10;<div>&#10;</div><div>We are hiring for our new Silicon R&amp;D center in Bangalore. Join our team as we pioneer the IPs that power the digital ASICs of tomorrow's mobile standards. Ericsson System on a Chip (SoC) devices are custom-made for mobile networks and spans across the Ericsson Radio System - RAN Compute, Radio and Transport &#8211; to enable communication service providers to surpass the expectations of their end-customers.&#10;</div><div>At our state-of-the-art design centers, we don't just follow industry trends&#8212;we set them. By leveraging cutting-edge tools and methodologies, we lead innovation in the telecommunications sector. As a valued team member, you'll play a pivotal role in shaping the future of global connectivity, contributing to the advancement of 5G and 6G technologies.&#10;</div><div>As part of our global R&amp;D organization, you'll collaborate with talented teams across Sweden, the US, and beyond. We are committed to fostering a collaborative and innovative work environment that encourages creativity and teamwork.&#10;</div><div>What We Offer&#10;</div><div>&#8226;&#9;Creative Freedom: Ericsson has a collaborative and inclusive culture that values diversity and innovation. Immerse yourself in an environment that champions innovation and critical thinking. You'll have the opportunity to explore advanced design technologies alongside skilled experts. &#10;</div><div>&#8226;&#9;Global Impact: Contribute to projects with far-reaching impacts, transforming industries, advancing digital economies, and enhancing communication worldwide.&#10;</div><div>&#8226;&#9;Work-Life Balance: We are committed to supporting the well-being of our team members by fostering a balanced work-life environment that empowers you to thrive professionally without compromising your personal life. With our competitive compensation and benefits package, we look forward to a long and rewarding journey together.&#10;</div><div>&#8226;&#9;Professional Growth: Engage in continuous learning opportunities, tackle exciting challenges, and collaborate with brilliant minds in a supportive and forward-thinking atmosphere.&#10;</div><div>&#8226;&#9;An international work environment: As a global organization, Ericsson offers abundant opportunities for professional growth and career development.&#10;</div><div>What you will do&#10;</div><div>&#8226;&#9;Take part in the ASIC IP design and/or verification together with other team members&#10;</div><div>&#8226;&#9;Develop/Improve state of the designs [RTL] and testbenches&#10;</div><div>&#8226;&#9;Collaborate closely with other verifiers, designers, and architects.&#10;</div><div>&#8226;&#9;Build competence in the technical domain.&#10;</div><div>You will bring&#10;</div><div>Required Qualifications:&#10;</div><div>&#8226; Master&#8217;s degree in electrical or computer engineering&#10;</div><div>&#8226;&#9;Knowledge of ASIC IP design and/or verification [0 to 5 years of experience]&#10;</div><div>Additional Requirements:&#10;</div><div>&#8226;&#9;Team-oriented, prioritizing team success &#10;</div><div>&#8226;&#9;High attention to detail and commitment to quality.&#10;</div><div>&#8226;&#9;Strong focus on meeting project deadlines and deliverables.&#10;</div><div>&#8226;&#9;Strong communication skills.&#10;</div><div><br></div><div>Education&#9;Y</div><div>Master's degree&#9;&#9;&#10;</div><div>Knowledge of ASIC IP design and/or verification</div><div>&#10;</div><div>&#10;</div><div>&#10;</div><div>&#10;</div><div>&#10;</div><div>&#10;</div><div>&#10;</div>","additional_details":null,"is_notification_muted":true,"is_withdrawal_same_as_application_deadline":false,"is_new_company":false,"is_display_name_same_as_company_name":true,"is_included_in_application_matrix":false,"display_name":"Ericsson Global India Services","is_published":true,"is_deleted":false,"is_process_completed":false,"created_by":10843,"created_by_name":"Keya Sengupta","updated_by":10658,"created_at":1774600048000,"updated_at":1774850385000,"company_query":{"overview":null,"city":null,"state":null,"zip":null,"pan":null,"contacts":null,"sourceHistory":null,"placecoms":null,"approved":false,"company_id":1696,"company_name":"Ericsson Global India Services","source":"Existing Database","website_url":null,"logo":null,"industry":null,"address_line_1":null,"address_line_2":null,"is_approved":false,"is_disabled":false,"primary_placecoms":null,"secondary_placecoms":null,"created_by":8524,"updated_by":8524,"created_at":1774423403