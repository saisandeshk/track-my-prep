{"status":"success","message":null,"data":{"responsibilities":null,"overview":null,"locations":"New Delhi, India.","processCompleted":false,"deleted":false,"mailPublished":true,"newCompany":false,"dream":false,"notificationMuted":true,"applied":false,"studentOopsOrFrozen":false,"modifyAllowed":false,"withdrawAllowed":false,"withdrawalDeadlineSameAsApplicationDeadline":false,"displayNameSameAsCompanyName":true,"includedInApplicationMatrix":false,"application_detail_id":4076,"application_id":591,"application_status_id":3,"placement_process_id":44,"batch_group_id":0,"batch_group_ids":"[59, 60]","dayslot_id":0,"cluster_id":0,"cluster_sequence_number":0,"job_function_id":0,"uuid":"e171c30d-b7e6-4955-87fe-bb1a77cada72","sector_id":35,"company_id":746,"max_roles_to_be_applied":null,"company_name":"EdgeFleet.AI","job_title":"Computer Vision Engineer","sector_label":"Engineering and Technology","other_sector":"","max_roles":0,"job_summary":"","job_function":"","job_description":"","process_name":"FT 2025-26","batch_group_label":"","skills":"Strong foundation in Computer Vision and Deep Learning\n3D Vision & Geometry,2D to 3D \nProgramming Proficiency-Python, C++\nStrong Mathematical skills-Linear Algebra, Optimization, Probability, and 3D Coordinate Systems\nCamera Calibration techniques","website_url":"https://www.edgefleet.ai/","eligibility_information":"Final year or recent graduates from B.Tech / B.E / M.Tech / M.S / Ph.D. programs in:\n\nComputer Science / Artificial Intelligence / Robotics /  Electronics / Mechatronics\n\nMinimum CGPA- 8.0","job_package":"","min_work_experience":0,"max_work_experience":0,"is_dream":false,"date_of_visit":null,"publish_time":1762771036000,"withdrawl_deadline":1764135000000,"application_deadline":1764135000000,"application_start_time":1763065800000,"additional_information":"<b>&#128640; EdgeFleet.AI is Calling the Visionaries</b><div>&#10;</div><div>&#10;</div><div>&#10;</div><div>&#10;</div><div>&#10;</div><div>&#10;</div><div>&#10;</div><div>&#10;</div><div>&#10;</div><div>&#10;</div><div>&#10;</div><div>&#10;</div><div>&#10;</div><div>&#10;</div><div>&#10;</div><div>&#10;</div><div>&#10;</div><div>&#10;</div><div>&#10;</div><div>&#10;</div><div>&#10;</div><div>&#10;</div><div>&#10;</div><div>&#10;</div><div>Where Machines Don&#8217;t Just See &#8212; They Understand.</div><div><b><br></b></div><div><b>&#129517; About EdgeFleet.AI</b></div><div>At EdgeFleet.AI, we are building something extraordinary &#8212;<span>an intelligence that transcends boundaries, disciplines, and machines.</span></div><div><span>Think of it as a shared brain for autonomous systems &#8212;</span><span>where drones, robots, and fleets don&#8217;t just operate&#8230; they perceive, predict, and understand the world around them.</span></div><div><span>We&#8217;re pushing the limits of computer vision, from recognition to reconstruction, prediction, and spatial reasoning &#8212; creating the eyes and instincts of next-gen autonomy.</span></div><div><span><br></span></div><div><span>&#128188; <b>Role: Computer Vision Engineer<br>&#160; &#160; &#160; Location: </b>New Delhi, India.<br><b>&#160; &#160; &#160; Type : </b>Full Time (On-Site)</span></div><div><br></div><div><b>&#129504; What You&#8217;ll Work On</b></div><div><br></div><div>You will be at the core of EdgeFleet.AI&#8217;s perception systems &#8212; designing how autonomous machines see and understand reality.</div><div><br></div><div><b>Your Mission:</b></div><div><span>Build real-time 3D perception pipelines (SLAM, SfM, NeRF, Gaussian Splatting).</span></div><div><span>Develop self-supervised learning and multi-view geometry systems.</span></div><div><span>Implement object tracking, depth estimation, and pose prediction for real-world Robots.</span></div><div><span>Collaborate on sensor fusion, reconstruction, and AI-based spatial understanding.</span></div><div><span>Contribute to open research and prototype breakthroughs in computer vision.<br><br>&#127891; <b>Eligibility Criteria<br>Education:</b></span></div><div><span>B.Tech / B.E / M.Tech / M.S / Ph.D. in</span></div><div><span>Computer Science, Artificial Intelligence, Robotics, or Electronics.<br><b>Minimum CGPA: </b>8</span><span>.0 or above</span></div><div><span><br></span></div><div><span><b>&#129513; Skill Set You&#8217;ll Need</b></span></div><div><span><b>Core Competencies</b></span></div><div><span>Computer Vision &amp; Deep Learning (CNNs, Transformers, Self-Supervised Learning)</span></div><div><span>SLAM, SfM, NeRF, Gaussian Splatting, 3D Reconstruction</span></div><div><span>Multi-View Geometry, Epipolar Geometry, Depth &amp; Pose Estimation</span></div><div><span>Python, PyTorch / TensorFlow, OpenCV, NumPy, CUDA<br>2D to 3D Conversion techniques<br>Camera calibration Techniques</span></div><div><span><br></span></div><div><span><b>Bonus Skills</b></span></div><div><span>ROS, Blender / Unreal / Unity for simulation</span></div><div><span>Differentiable rendering frameworks (e.g., Instant-NGP, Nerfstudio, COLMAP)<br><b><br>&#128161; What We Value</b></span></div><div><span>A visionary mindset &#8212; seeing systems, not just scripts.</span></div><div><span>Curiosity and boldness to explore uncharted research directions.</span></div><div><span>Strong mathematical reasoning and coding discipline.</span></div><div><span>Passion for robotics, drones, and spatial AI.</span></div><div><span>Desire to build and lead &#8212; not just follow.<br><br><b>&#127756; Why Join Us</b></span></div><div><span>Build the perception backbone of future fleets and robots.</span></div><div><span>Blend research + real-world impact in one role.</span></div><div><span>Work with visionaries in AI, robotics, and computer vision.</span></div><div><span>Push the limits of spatial intelligence &#8212; and your own imagination.<br><br>&#10024; At EdgeFleet.AI, you won&#8217;t just be coding vision &#8212; you&#8217;ll be architecting perception itself.</span></div><div><span>Join us. Let&#8217;s make machines not just see&#8230; but perceive with purpose.</span></div>","additional_details":null,"is_notification_muted":true,"is_withdrawal_same_as_application_deadline":false,"is_new_company":false,"is_display_name_same_as_company_name":true,"is_included_in_application_matrix":false,"display_name":"EdgeFleet.ai","is_published":true,"is_deleted":false,"is_process_completed":false,"created_by":9812,"created_by_name":"Surya Srikar","updated_by":8524,"created_at":1760512326000,"updated_at":1764049556000,"company_query":{"overview":null,"city":null,"state":null,"zip":null,"pan":null,"contacts":null,"sourceHistory":null,"placecoms":null,"approved":false,"company_id":746,"company_name":"EdgeFleet.AI","source":null,"website_url":null,"logo":null,"industry":null,"address_line_1":null,"address_line_2":null,"is_approved":false,"is_disabled":false,"primary_placecoms":null,"secondary_placecoms":null,"created_by":8524,"updated_by":8524,"created_at":1760341820000,"updated_at":1760341820000},"questions":[],"documents":[],"offer_letter_sample_copy":[],"applicant_status":null,"eligibility_message":"","job_roles":[{"deleted":false,"published":true,"applied":false,"application_job_role_id":871,"application_id":591,"job_role_id":577,"company_id":746,"company_name":"EdgeFleet.AI","display_name":"EdgeFleet.ai","job_title":"Computer Vision Engineer","job_role_label":"Computer Vision Engineer","placement_process_id":44,"cluster_id":0,"job_function_id":0,"job_function_label":"","sector_id":35,"sector_label":"Engineering and Technology","is_deleted":false,"is_published":true,"cluster_name":"0","id":0,"cv_variant_id":0,"preference":0,"shortlist_status_id":0,"role_wise_stages":[{"application_stage_id":3454,"application_id":591,"job_role_id":577,"json_key":"rs","job_role_label":"Computer Vision Engineer","stage_id":91,"stage_sequence_number":1,"stage_label":"Resume Shortlisting","date_of_process":null,"remarks":""},{"application_stage_id":3455,"application_id":591,"job_role_id":577,