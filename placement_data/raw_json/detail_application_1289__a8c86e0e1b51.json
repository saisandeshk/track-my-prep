{"status":"success","message":null,"data":{"responsibilities":null,"overview":null,"locations":"Bengaluru","processCompleted":false,"deleted":false,"mailPublished":true,"newCompany":false,"dream":false,"notificationMuted":false,"applied":false,"studentOopsOrFrozen":false,"modifyAllowed":false,"withdrawAllowed":false,"withdrawalDeadlineSameAsApplicationDeadline":false,"displayNameSameAsCompanyName":true,"includedInApplicationMatrix":false,"application_detail_id":6310,"application_id":1289,"application_status_id":3,"placement_process_id":44,"batch_group_id":0,"batch_group_ids":"[59, 60]","dayslot_id":0,"cluster_id":0,"cluster_sequence_number":0,"job_function_id":0,"uuid":"b07fc049-9dc5-4b01-aca1-f96268e0ba46","sector_id":35,"company_id":1718,"max_roles_to_be_applied":0,"company_name":"Altimate AI","job_title":"  Research Intern","sector_label":"Engineering and Technology","other_sector":"","max_roles":0,"job_summary":"","job_function":"","job_description":"","process_name":"FT 2025-26","batch_group_label":"","skills":"What we're looking for:\n\n- Hands-on with PyTorch and the Hugging Face ecosystem\n- At least one prior project involving LLMs - fine-tuning, evals, agents, or RAG\n- Comfortable reading recent papers (NeurIPS / ICML / ACL / EMNLP) and implementing ideas from them\n- Can take a fuzzy problem and return a well-scoped experiment\n- Bonus: familiarity with dbt, SQL, or the modern data stack; open-source contributions; prior publications","website_url":"https://www.altimate.ai/","eligibility_information":"Added in JD","job_package":"","min_work_experience":0,"max_work_experience":0,"is_dream":false,"date_of_visit":null,"publish_time":1778151176000,"withdrawl_deadline":1778239836000,"application_deadline":1778239836000,"application_start_time":1778151386000,"additional_information":"Research Intern (LLM &amp; AI Agents)&#10;<div>&#10;</div><div>About Us&#10;</div><div>Altimate AI is pioneering agentic data engineering - instead of engineers manually writing queries and managing pipelines, we're building AI agents that do this work autonomously. Think of it as AI teammates for data teams.&#10;</div><div>We're #1 on the industry benchmark in this space. Our open-source developer tools have 1M+ downloads (including the dbt Power User extension with 200k+ downloads alone), and we're trusted by companies like Cisco, Rakuten, Pepsi, and Block. Backed by Canaan Partners and Sierra Ventures.&#10;</div><div>Our agents write SQL, optimize warehouses, and enforce data quality across dbt, Snowflake, Databricks, and BigQuery &#8212; and we're just getting started.&#10;</div><div>We're hiring a research intern to work directly with the founding team on hard problems at the intersection of LLMs, agents, and the modern data stack.&#10;</div><div>Potential research areas :&#10;</div><div>- Agent evaluation for data engineering - design benchmarks and eval harnesses to measure how well coding agents (Claude Code, Cursor, Altimate code) perform on real dbt and SQL tasks. Where do they fail? What does &#34;correct&#34; even mean for a data transformation?&#10;</div><div>- LLM-based query understanding - explore embeddings, fine-tuning, and prompting approaches for SQL/dbt model representation. Applications: query similarity, cost prediction, lineage inference.&#10;</div><div>- Guardrails for data agents - topic filtering, schema-aware hallucination detection, and safety layers for LLM-generated SQL.&#10;</div><div>You'll own a research question end-to-end: scope it, run experiments, write it up. Strong work has a path to a public technical blog post, open-source release, or paper.&#10;</div><div>What we're looking for:&#10;</div><div>- Hands-on with PyTorch and the Hugging Face ecosystem&#10;</div><div>- At least one prior project involving LLMs - fine-tuning, evals, agents, or RAG&#10;</div><div>- Comfortable reading recent papers (NeurIPS / ICML / ACL / EMNLP) and implementing ideas from them&#10;</div><div>- Can take a fuzzy problem and return a well-scoped experiment&#10;</div><div>- Bonus: familiarity with dbt, SQL, or the modern data stack; open-source contributions; prior publications</div><div>&#10;</div><div>&#10;</div><div>&#10;</div><div>&#10;</div><div>&#10;</div><div>&#10;</div>","additional_details":"NA","is_notification_muted":false,"is_withdrawal_same_as_application_deadline":false,"is_new_company":false,"is_display_name_same_as_company_name":true,"is_included_in_application_matrix":false,"display_name":"Altimate AI","is_published":true,"is_deleted":false,"is_process_completed":false,"created_by":10660,"created_by_name":"Kugan P","updated_by":10660,"created_at":1778151114000,"updated_at":1778151177000,"company_query":{"overview":null,"city":null,"state":null,"zip":null,"pan":null,"contacts":null,"sourceHistory":null,"placecoms":null,"approved":false,"company_id":1718,"company_name":"Altimate AI","source":"Inbound Query","website_url":null,"logo":null,"industry":null,"address_line_1":null,"address_line_2":null,"is_approved":false,"is_disabled":false,"primary_placecoms":null,"secondary_placecoms":null,"created_by":8526,"updated_by":10660,"created_at":1776098161000,"updated_at":1784607770000},"questions":[],"documents":[],"offer_letter_sample_copy":[],"applicant_status":null,"eligibility_message":"","job_roles":[{"deleted":false,"published":true,"applied":false,"application_job_role_id":1623,"application_id":1289,"job_role_id":181,"company_id":1718,"company_name":"Altimate AI","display_name":"Altimate AI","job_title":"  Research Intern","job_role_label":"Research Intern","placement_process_id":44,"cluster_id":0,"job_function_id":0,"job_function_label":"","sector_id":35,"sector_label":"Engineering and Technology","is_deleted":false,"is_published":true,"cluster_name":"0","id":0,"cv_variant_id":0,"preference":0,"shortlist_status_id":0,"role_wise_stages":[{"application_stage_id":7002,"application_id":1289,"job_role_id":181,"json_key":"pi","job_role_label":"Research Intern","stage_id":87,"sta