{"status":"success","message":null,"data":{"responsibilities":null,"overview":null,"locations":"Bengaluru ","processCompleted":false,"deleted":false,"mailPublished":true,"newCompany":false,"dream":false,"notificationMuted":true,"applied":false,"studentOopsOrFrozen":false,"modifyAllowed":false,"withdrawAllowed":false,"withdrawalDeadlineSameAsApplicationDeadline":false,"displayNameSameAsCompanyName":true,"includedInApplicationMatrix":false,"application_detail_id":4524,"application_id":776,"application_status_id":3,"placement_process_id":44,"batch_group_id":0,"batch_group_ids":"[59, 60]","dayslot_id":0,"cluster_id":0,"cluster_sequence_number":0,"job_function_id":0,"uuid":"b31584e5-fc6a-4b65-b46e-164c0e0bdb67","sector_id":46,"company_id":992,"max_roles_to_be_applied":null,"company_name":"LTIMindtree","job_title":"Research Engineer  (Quantum Technologies)","sector_label":"Information Technology (IT)","other_sector":"","max_roles":0,"job_summary":"","job_function":"","job_description":"","process_name":"FT 2025-26","batch_group_label":"","skills":" Quantum Technology/Mathematics/Physics/Quantum Chemistry","website_url":"https://www.ltimindtree.com/","eligibility_information":"Consistent academic records of 60% above OR Equivalent CGPA in 10th, 12th, Diploma (as \napplicable), UG and PG courses (aggregate of all semesters & subjects)  \nAppropriate CGPA to percentage conversion to be considered as per the respective university \nnorms. The scores of the Main or improvement exam would be considered as final.  \nFor candidates who have pursued both HSC and Diploma, marks scored in the Diploma course will \nbe considered.\n\n\n\nInitial results (% scores) declared would be considered for students awaiting re-evaluation results.  \n \nAt the time of recruitment process, there must be no standing arrears in current education \n\n\nNot more than 2 years academic gap allowed. (SSC/HSC/Diploma/UG/PG) \n","job_package":"","min_work_experience":0,"max_work_experience":0,"is_dream":false,"date_of_visit":null,"publish_time":1763981667000,"withdrawl_deadline":1764066600000,"application_deadline":1764066600000,"application_start_time":1763981700000,"additional_information":"This role will involve hands-on development of industry solutions using quantum &#10;<div>technologies. The successful candidate: - Will be part of LTIMindtree&#8217;s Research - Emerging Technology Group, and will focus on &#10;</div><div>applied research to develop quantum-powered software applications and solutions for &#10;</div><div>various industries - Work with business units to identify and prioritize suitable Quantum Computing /Quantum &#10;</div><div>Tech use cases - Implement / reproduce / adapt recent research papers. - Develop QC/QT proofs-of-concept, leading ultimately to commercially viable products and &#10;</div><div>services - Engage with QC/QT vendors and academic partners - Participate in LTIMindtree&#8217;s quantum related collaboration projects with external partners.</div><div><br></div><div><br></div><div>Required Skills &amp; Competencies &#10;</div><div>Math related skills: (Candidates should have good familiarity with 2 or more of the &#10;</div><div>following) ---------------------------------------------------------------------------------------------------- &#10;</div><div>1. Strong in Linear Algebra  &#10;</div><div>2. Probability, Calculus and Statistics &#10;</div><div>3. Differential Equations (ODE, PDE, SDE) (optional) &#10;</div><div>4. Exposure to Combinatorial Optimization  &#10;</div><div>5. Exposure to ISING models (optional) &#10;</div><div>6. Exposure to Information Theory (optional) &#10;</div><div>Computer Science skills: (Candidates should have good familiarity with 3 or more of the &#10;</div><div>following) ------------------------------------------------------------------------------------------------------ &#10;</div><div>1. Data structure and Algorithms. Familiarity with algorithm analysis. &#10;</div><div>2. Programming language - Python &#10;</div><div>3. Quantum programming frameworks like IBM Qiskit, AWS BraKet etc &#10;</div><div>3. Basics of Machine Learning, Optimization, Graphs, and Algorithms on Graph preferable &#10;</div><div>4. Exposure to the modeling of systems and simulations would be an added advantage. &#10;</div><div>5. Working knowledge of PyTorch / TensorFlow / Keras (optional) &#10;</div><div>Quantum Tech Skills: --------------------- &#10;</div><div>1. Quantum Information Concepts and Foundations &#10;</div><div>2. Quantum transformations, dynamics, Multi-qubit systems &#10;</div><div>3. Quantum Algorithms (Grover, Deutsch&#8211;Jozsa, Quantum Fourier Transform, Quantum &#10;</div><div>Phase Estimation, Shor's factoring algorithm etc) &#10;</div><div>4. Ability to write gate-based programs to implement some of the above quantum &#10;</div><div>algorithms &#10;</div><div>5. Familiarity with Quantum Annealing paradigm &#10;</div><div>6. Approximate &amp; Variational Quantum Algorithms (QAOA, VQE variants) &#10;</div><div>7. Understanding of Density Matrices &amp; open quantum systems &#10;</div><div>8. Knowledge of Quantum Error Correction (optional) &#10;</div><div>9. Knowledge of Quantum Error Mitigation techniques (Optional) &#10;</div><div>10. Exposure to basics of quantum hardware platforms (superconducting, neutral atom etc) &#10;</div><div>Candidates who have taken courses in quantum physics, quantum information science or &#10;</div><div>quantum computing would be preferred. &#10;</div><div>The candidate should have interest in latest research developments in the quantum &#10;</div><div>computing field and have the ability to read research literature and form a point of view. &#10;</div><div>The candidate should have the ability to implement / adapt techniques in research paper for &#10;</div><div>a given problem.  &#10;</div><div>Project / Internship experience in quantum computing applications or related areas is &#10;</div><div>desirable. &#10;</div><div>Candidates with research publications in Quantum Science or Information preferred.</div>","additional_details":null,"is_notification_muted":true,"is_withdrawal_same_as_application_deadline":false,"is_new_company":false,"is_display_name_same_as_company_name":true,"is_included_in_application_matrix":false,"display_name":"LTIMindtree","is_published":true,"is_deleted":false,"is_process_completed":false,"created_by":8527,"created_by_name":"Program Assistant","updated_by":8526,"created_at":1763449383000,"updated_at":1763981667000,"company_query":{"overview":null,"city":null,"state":null,"zip":null,"pan":null,"contacts":null,"sourceHistory":null,"placecoms":null,"approved":false,"company_id":992,"company_name":"LTIMindtree","source":"Existing Database","website_url":null,"logo":null,"industry":null,"address_line_1":null,"address_line_2":null,"is_approved":false,"is_disabled":false,"primary_placecoms":null,"secondary_placecoms":null,"created_by":8524,"updated_by":10660,"created_at":1760341820000,"updated_at":1784609079000},"questions":[{"mcqOptions":null,"mcqId":0,"answer":null,"answered":false,"question_id":444,"application_id":776,"question_type_id":1,"question":"Mention the backlogs, Else NA ","is_mandatory":true,"options":null,"min_select":null,"max_select":null,"is_deleted":false,"created_by":8527,"updated_by":8527,"created_at":1763449383000,"choices":null,"updated_at":1763449383000,"student_answer_id":0,"document_id":0,"file_original_name":null,"uuid":null},{"mcqOptions":null,"mcqId":0,"answer":null,"answered":false,"question_id":445,"application_id":776,"question_type_id":1,"question":"Name of the Father","is_mandatory":true,"options":null,"min_select":null,"max_select":null,"is_deleted":false,"created_by":8527,"updated_by":8527,"created_at":1763449383000,"choices":null,"updated_at":1763449383000,"student_answer_id":0,"document_id":0,"file_original_name":null,"uuid":null},{"mcqOptions":null,"mcqId":0,"answer":null,"answered":false,"question_id":446,"application_id":776,"