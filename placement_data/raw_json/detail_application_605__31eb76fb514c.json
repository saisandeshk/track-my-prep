{"status":"success","message":null,"data":{"responsibilities":null,"overview":null,"locations":"Bangalore","processCompleted":false,"deleted":false,"mailPublished":true,"newCompany":false,"dream":false,"notificationMuted":true,"applied":false,"studentOopsOrFrozen":false,"modifyAllowed":false,"withdrawAllowed":false,"withdrawalDeadlineSameAsApplicationDeadline":false,"displayNameSameAsCompanyName":true,"includedInApplicationMatrix":false,"application_detail_id":3750,"application_id":605,"application_status_id":3,"placement_process_id":44,"batch_group_id":0,"batch_group_ids":"[59, 60]","dayslot_id":0,"cluster_id":0,"cluster_sequence_number":0,"job_function_id":0,"uuid":"c5b222c6-5471-4367-9d1f-11b3e2578ea1","sector_id":46,"company_id":857,"max_roles_to_be_applied":null,"company_name":"HP","job_title":"AI and full stack  development","sector_label":"Information Technology (IT)","other_sector":"","max_roles":0,"job_summary":"","job_function":"","job_description":"","process_name":"FT 2025-26","batch_group_label":"","skills":"AI/ML frameworks: PyTorch, TensorFlow, scikit-learn \no Web technologies: React.js, Node.js, Express, RESTful APIs \no Databases: PostgreSQL, MongoDB, or TimescaleDB \no Dev tools: Git, Docker, CI/CD pipelines ","website_url":"https://www.hp.com/in-en/home.html","eligibility_information":"Bachelor’s degree in Computer Science, Electronics, Mathematics. \n• Strong grasp of data structures, algorithms, system design, and core CS \nfundamentals. \n• Proficiency in full stack technologies including but not limited to Python for \nAI/ML, and JavaScript/TypeScript for full stack development. \n•","job_package":"","min_work_experience":0,"max_work_experience":0,"is_dream":false,"date_of_visit":null,"publish_time":1762344300000,"withdrawl_deadline":1762482600000,"application_deadline":1762482600000,"application_start_time":1762344601000,"additional_information":"Key Responsibilities &#10;<div>AI / Data Engineering &#10;</div><div>&#8226; Build and train machine learning/deep learning models for sensor and IoT data &#10;</div><div>(time series, image, or audio). &#10;</div><div>&#8226; Apply statistical analysis, signal processing, and ML to derive insights from noisy &#10;</div><div>data streams. &#10;</div><div>&#8226; Optimize models for real-time inference on edge devices using TensorFlow Lite, &#10;</div><div>ONNX, or similar. &#10;</div><div>&#8226; Contribute to data pipelines for collecting, cleaning, and validating large-scale &#10;</div><div>IoT data. &#10;</div><div>Full Stack Engineering &#10;</div><div>&#8226; Design and develop scalable and responsive web applications and APIs. &#10;</div><div>&#8226; Build dashboard interfaces for visualizing real-time device data, alerts, and &#10;</div><div>insights. &#10;</div><div>&#8226; Implement backend systems to process, store, and manage IoT data efficiently. &#10;</div><div>&#8226; Collaborate across teams to integrate AI features into the application stack &#10;</div><div>(frontend/backend/cloud). &#10;</div><div>What We&#8217;re Looking For &#10;</div><div>&#8226; Bachelor&#8217;s or Master&#8217;s degree in Computer Science, Electronics, Mathematics. &#10;</div><div>&#8226; Strong grasp of data structures, algorithms, system design, and core CS &#10;</div><div>fundamentals. &#10;</div><div>&#8226; Proficiency in full stack technologies including but not limited to Python for &#10;</div><div>AI/ML, and JavaScript/TypeScript for full stack development. &#10;</div><div>&#8226; Experience or familiarity with: &#10;</div><div>o AI/ML frameworks: PyTorch, TensorFlow, scikit-learn &#10;</div><div>o Web technologies: React.js, Node.js, Express, RESTful APIs &#10;</div><div>o Databases: PostgreSQL, MongoDB, or TimescaleDB &#10;</div><div>o Dev tools: Git, Docker, CI/CD pipelines &#10;</div><div>Soft Skills &#10;</div><div>&#8226; Strong problem-solving skills and a product mindset. &#10;</div><div>&#8226; Ability to work in a fast-paced, startup-like environment. &#10;</div><div>&#8226; Curiosity to explore new technologies and cross-functional learning (AI + &#10;</div><div>connected systems + UX). &#10;</div><div>&#8226; Collaborate as well as lead small groups of engineers to deliver innovative &#10;</div><div>solutions.  &#10;</div><div>&#8226; Ability to learn and leverage the latest technology advances. Drives curiosity in &#10;</div><div>teams to enable the adoption of latest and the best technologies. &#10;</div><div>What You&#8217;ll Gain &#10;</div><div>&#8226; Exposure to end-to-end product development in AI + connected ecosystems.  &#10;</div><div>&#8226; Real-world impact: your code and models will run in live environments. &#10;</div><div>&#8226; Mentorship from senior engineers and AI researchers. &#10;</div><div>&#8226; A collaborative culture that fosters experimentation and learning.</div>","additional_details":null,"is_notification_muted":true,"is_withdrawal_same_as_application_deadline":false,"is_new_company":false,"is_display_name_same_as_company_name":true,"is_included_in_application_matrix":false,"display_name":"HP","is_published":true,"is_deleted":false,"is_process_completed":false,"created_by":9837,"created_by_name":"Pradeep P","updated_by":8526,"created_at":1760527669000,"updated_at":1762430914000,"company_query":{"overview":null,"city":null,"state":null,"zip":null,"pan":null,"contacts":null,"sourceHistory":null,"placecoms":null,"approved":false,"company_id":857,"company_name":"HP","source":null,"website_url":null,"logo":null,"industry":null,"address_line_1":null,"address_line_2":null,"is_approved":false,"is_disabled":false,"primary_placecoms":null,"secondary_placecoms":null,"created_by":8524,"updated_by":9578,"created_at":1760341820000,"updated_at":1764934445000},"questions":[],"documents":[{"documentName":null,"jd_document_id":699,"application_id":605,"document_id":8722,"user_id":9837,"document_type_id":5,"uuid":"58398d2b-bd1a-4729-921c-fe38c770e595","file_name":"AI and full stack development","file