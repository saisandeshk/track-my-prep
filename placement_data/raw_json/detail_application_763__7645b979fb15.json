{"status":"success","message":null,"data":{"responsibilities":null,"overview":null,"locations":"Bangalore","processCompleted":false,"deleted":false,"mailPublished":true,"newCompany":false,"dream":false,"notificationMuted":true,"applied":false,"studentOopsOrFrozen":false,"modifyAllowed":false,"withdrawAllowed":false,"withdrawalDeadlineSameAsApplicationDeadline":false,"displayNameSameAsCompanyName":true,"includedInApplicationMatrix":false,"application_detail_id":4575,"application_id":763,"application_status_id":3,"placement_process_id":44,"batch_group_id":0,"batch_group_ids":"[59, 60]","dayslot_id":0,"cluster_id":0,"cluster_sequence_number":0,"job_function_id":0,"uuid":"1ccbd3b4-8db0-4631-a9bb-a653502f748a","sector_id":20,"company_id":499,"max_roles_to_be_applied":null,"company_name":"Airbus","job_title":"Associate Engineer - Loads and Aeroelasticity","sector_label":"Aerospace and Defense","other_sector":"","max_roles":0,"job_summary":"","job_function":"","job_description":"","process_name":"FT 2025-26","batch_group_label":"","skills":"Flight mechanics\nBasic Aerodynamics\nStructural dynamics\nControl theory\nProgramming skills in MATLAB, Python are a plus","website_url":"https://www.airbus.com/en/about-us/our-worldwide-presence/airbus-in-asia-pacific/airbus-in-india","eligibility_information":"Bachelors or Masters degree in Aeronautical, Mechanical engineering or related disciplines\n","job_package":"","min_work_experience":0,"max_work_experience":0,"is_dream":false,"date_of_visit":null,"publish_time":1763138559000,"withdrawl_deadline":1763224839000,"application_deadline":1763224839000,"application_start_time":1763138727000,"additional_information":"We are seeking a Loads &amp; Aeroelastics Engineer to join our team, responsible for delivering loads and aeroelastics solutions throughout the aircraft lifecycle, from development to in-service support.<div><br><div><b>Your key responsibilities will include:&#10;</b></div><div>Modelling and simulating aircraft aerodynamics, inertia, flexibility, landing gear, control systems, and flight mechanics. Your work will be critical in calculating and analyzing all external loads on the aircraft, including those from manoeuvres, turbulence, landing impacts, ground-handling etc.&#10;</div><div>Ensuring that the aircraft remains free of flutter and other aeroelastic phenomena across its entire operating envelope through detailed modelling and analysis of aircraft structural dynamics.&#10;</div><div>Deliver aircraft loads and aeroelastics documentation and data essential for the safe dimensioning of the aircraft structure and for achieving certification in accordance with time, cost, and quality standards.&#10;</div><div>Provide recommendations for aircraft design, development processes, new technologies, and in-service operations, all related to the loads and aeroelastics field.&#10;</div><div>&#160;Apply all relevant quality assurance processes, such as lessons learned, continuous improvement, and adherence to Quality Gates.&#10;</div><div><br></div><div><b>Education &amp; Experience&#10;</b></div><div>Bachelors or Masters degree in Aeronautical, Mechanical engineering or related disciplines&#10;</div><div>&#8203;&#10;</div><div><b>Required Technical Expertise:&#10;</b></div><div>Flight mechanics&#10;</div><div>Basic Aerodynamics&#10;</div><div>Structural dynamics&#10;</div><div>Control theory</div><div>Programming skills in MATLAB, Python  are a plus&#10;</div><div><br></div><div><b>Soft Skills&#10;</b></div><div>&#160;Teamwork (high priority!)&#10;</div><div>&#160;Good communication skills&#10;</div><div>&#160;Willingness to learn new skills, self-development&#10;</div><div>Problem-solving orientation</div><div> &#10;</div></div>","additional_details":null,"is_notification_muted":true,"is_withdrawal_same_as_application_deadline":false,"is_new_company":false,"is_display_name_same_as_company_name":true,"is_included_in_application_matrix":false,"display_name":"Airbus India Private Limited","i