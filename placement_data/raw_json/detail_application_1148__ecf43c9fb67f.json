{"status":"success","message":null,"data":{"responsibilities":null,"overview":null,"locations":"New Delhi","processCompleted":false,"deleted":false,"mailPublished":true,"newCompany":false,"dream":false,"notificationMuted":true,"applied":false,"studentOopsOrFrozen":false,"modifyAllowed":false,"withdrawAllowed":false,"withdrawalDeadlineSameAsApplicationDeadline":false,"displayNameSameAsCompanyName":true,"includedInApplicationMatrix":false,"application_detail_id":5752,"application_id":1148,"application_status_id":3,"placement_process_id":44,"batch_group_id":0,"batch_group_ids":"[59, 60]","dayslot_id":0,"cluster_id":0,"cluster_sequence_number":0,"job_function_id":0,"uuid":"fe18be1e-5463-45dd-ade2-b504dcf8f9d4","sector_id":35,"company_id":746,"max_roles_to_be_applied":2,"company_name":"EdgeFleet.AI","job_title":"Full Stack Engineer","sector_label":"Engineering and Technology","other_sector":"","max_roles":0,"job_summary":"","job_function":"","job_description":"","process_name":"FT 2025-26","batch_group_label":"","skills":"Strong fundamentals in programming, data structures, and problem-solving\nSolid understanding of web applications end-to-end\nExperience with JavaScript / TypeScript\nHands-on with frontend frameworks (React, Next.js, or similar)\nExperience building RESTful APIs and working with asynchronous systems\nFamiliarity with databases (PostgreSQL, MySQL, MongoDB, etc.)\nWorking knowledge of Git and collaborative workflows\nComfortable working in fast-paced, evolving environments\nClear communication and a strong team-first mindset\nOpenness to learning new tools, frameworks, and technologies","website_url":"https://www.edgefleet.ai/","eligibility_information":"CGPA : 7.5","job_package":"","min_work_experience":0,"max_work_experience":0,"is_dream":false,"date_of_visit":null,"publish_time":1773049665000,"withdrawl_deadline":1773376282000,"application_deadline":1773376282000,"application_start_time":1773049812000,"additional_information":"<b>EdgeFleet.AI is Hiring &#8211; Full-Stack Engineer&#10;</b><div>Where intelligent systems meet scalable software.&#10;</div><div>Build the backbone of next-generation AI products powering vision, language,&#160;<span>and real-time intelligence at the edge.</span></div><div><b>&#128640; About EdgeFleet.AI&#10;</b></div><div>At EdgeFleet.AI, we are building a unified intelligence layer for autonomous&#160;<span>and edge systems &#8212; where AI models, real-time data, and user-facing&#160;</span><span>platforms come together seamlessly.</span></div><div>Our products sit at the intersection of Computer Vision, AI infrastructure,&#160;<span>and scalable web platforms, enabling machines to not just perceive the&#160;</span><span>world, but to reason, communicate, and act.</span></div><div><b>&#128640; Role Details&#10;</b></div><div>Location: New Delhi, India&#10;</div><div>Type: Full-Time (On-site)&#10;</div><div><b>&#128640; About the Role&#10;</b></div><div>We&#8217;re looking for a curious, driven Full-Stack Engineer who enjoys building&#160;<span>end-to-end systems &#8212; from robust backend services to intuitive frontend&#160;</span><span>interfaces.</span></div><div>This role is ideal for someone who:&#10;</div><div>Loves owning features from idea deployment&#8594;&#10;</div><div>Enjoys working close to AI/ML systems and real-world data</div><div><span>Values clean code, performance, and scalability</span></div><div>Thrives in a fast-moving, collaborative startup environment&#10;</div><div>You&#8217;ll work closely with AI engineers, product teams, and designers to build&#160;<span>platforms that power EdgeFleet&#8217;s AI-driven products.&#128736;&#65039;</span></div><div><b>What You&#8217;ll Do&#10;</b></div><div>Design, develop, and maintain scalable backend services and REST&#160;<span>APIs</span></div><div>Build and integrate frontend interfaces with backend and AI systems&#10;</div><div>Work closely with AI/ML teams to expose models via APIs and&#160;<span>dashboards</span></div><div>Implement real-time and data-driven features for AI-powered&#160;<span>applications</span></div><div>Write clean, readable, and maintainable code&#10;</div><div>Optimize system performance, reliability, and scalability&#10;</div><div>Debug issues, refactor legacy components, and improve overall code&#160;<span>quality</span></div><div>Participate in architecture discussions and technical decision-making&#10;</div><div><b>&#9989; What We&#8217;re Looking For&#10;</b></div><div>Strong fundamentals in programming, data structures, and problem-<span>solving</span></div><div>Solid understanding of web applications end-to-end&#10;</div><div>Experience with JavaScript / TypeScript&#10;</div><div>Hands-on with frontend frameworks (React, Next.js, or similar)&#10;</div><div>Experience building RESTful APIs and working with asynchronous&#160;<span>systems</span></div><div>Familiarity with databases (PostgreSQL, MySQL, MongoDB, etc.)&#10;</div><div>Working knowledge of Git and collaborative workflows&#10;</div><div>Comfortable working in fast-paced, evolving environments&#10;</div><div>Clear communication and a strong team-first mindset&#10;</div><div>Openness to learning new tools, frameworks, and technologies&#10;</div><div><b>&#128640; Bonus (Nice to Have)&#10;</b></div><div>Exposure to Python-based backends (FastAPI, Flask, Django)&#10;</div><div>Experience integrating with AI/ML services or inference pipelines&#10;</div><div>Familiarity with cloud platforms (AWS, GCP, Azure)&#10;</div><div>Basic understanding of Docker / containerized deployments&#10;</div><div>&#160;Interest in AI, Computer Vision, or real-time systems</div>","additional_details":null,"is_notification_muted":true,"is_withdrawal_same_as_application_deadline":false,"is_new_company":false,"is_display_name_same_as_company_name":true,"is_included_in_application_matrix":false,"display_name":"EdgeFleet.AI","is_published":true,"is_deleted":false,"is_process_completed":false,"created_by":9812,"created_by_n