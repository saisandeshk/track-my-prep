{"status":"success","message":null,"data":{"responsibilities":null,"overview":null,"locations":"Bangalore","processCompleted":false,"deleted":false,"mailPublished":true,"newCompany":false,"dream":false,"notificationMuted":false,"applied":false,"studentOopsOrFrozen":false,"modifyAllowed":false,"withdrawAllowed":false,"withdrawalDeadlineSameAsApplicationDeadline":false,"displayNameSameAsCompanyName":true,"includedInApplicationMatrix":false,"application_detail_id":6601,"application_id":1346,"application_status_id":3,"placement_process_id":44,"batch_group_id":0,"batch_group_ids":"[59, 60]","dayslot_id":0,"cluster_id":0,"cluster_sequence_number":0,"job_function_id":0,"uuid":"03b456fa-5f49-4dde-baf4-88f5183763be","sector_id":66,"company_id":453,"max_roles_to_be_applied":6,"company_name":"Lam Research","job_title":"Engineering Intern 3","sector_label":"VLSI and Semiconductors","other_sector":"","max_roles":0,"job_summary":"","job_function":"","job_description":"","process_name":"FT 2025-26","batch_group_label":"","skills":"Plasma Trainee","website_url":"www.lamresearch.com","eligibility_information":"Cut off percentage: 65% Aggregate (No Active Backlog)","job_package":"","min_work_experience":0,"max_work_experience":0,"is_dream":false,"date_of_visit":null,"publish_time":1781256524000,"withdrawl_deadline":1781674218000,"application_deadline":1781674218000,"application_start_time":1781256555000,"additional_information":"Background:<div><br></div><div>Lam Research (India) is looking for interns to work on a critical project designing, building and testing a plasma training apparatus that will later be donated to CeNSE for training of future students. The internship will be for a period of 6 months, extendable if needed. It will require selected candidates to work in the Lam Research campus at Bagmane Tech Park in CV Raman Nagar, Bangalore.</div><div><br></div><div>Project Description:</div><div><br></div><div>The interns will be required to incorporate a new RF matching network into a plasma chamber. This will require design of mounting hardware and connectors to mate with the powered electrode in the chamber. After all parts are purchased, the interns will assemble the apparatus under supervision of Lam engineers and then characterize performance of the new RF Match under different process conditions. The end objective is to define an optimal process window for the chamber with the new match.</div><div><br></div><div>Tasks:</div><div><br></div><div>&#183; Evaluate difference between new match and existing match</div><div><br></div><div>&#183; Identify parts that need to be redesigned</div><div><br></div><div>&#183; Use appropriate CAD/CAE software provided by Lam to design the new parts</div><div><br></div><div>&#183; Work with Lam engineers to order required parts to build the apparatus</div><div><br></div><div>&#183; Conduct build-readiness evaluation</div><div><br></div><div>&#183; Assemble the plasma training apparatus</div><div><br></div><div>&#183; Conduct hardware readiness tests on the apparatus (vacuum, electrical, controls, communication, etc.)</div><div><br></div><div>&#183; Characterize performance of new match and compare with existing match</div><div><br></div><div>&#183; Define optimal process window for operating the training apparatus</div><div><br></div><div>Required Skills:</div><div><br></div><div>&#183; Familiarity with RF systems and hardware</div><div><br></div><div>&#183; Knowledge of vacuum systems and hardware</div><div><br></div><div>&#183; Ability to use MCAD software to design parts</div><div><br></div><div>&#183; Basic understanding of CCP reactors and associated process parameters</div><div><br></div><div>Qualifications:</div><div><br></div><div>2nd Year MTech or PhD students with a background in one of:</div><div><br></div><div>&#183; Mechanical Engineering</div><div><br></div><div>&#183; Electrical Engineering</div><div><br></div><div>&#183; Electronics Engineering</div><div><br></div><div>&#183; Chemical Engineering</div>","additional_details":null,"is_notification_muted":false,"is_withdrawal_same_as_application_deadline":false,"is_new_company":false,"is_display_name_same_as_company_name":true,"is_included_in_application_matrix":false,"display_name":"Lam Research","is_published":true,"is_deleted":false,"is_process_completed":false,"created_by":10943,"created_by_name":"Sneha M","updated_by":10943,"created_at":1781242683000,"updated_at":1781599824000,"company_query":{"overview":null,"city":null,"state":null,"zip":null,"pan":null,"contacts":null,"sourceHistory":null,"placecoms":null,"approved":false,"company_id":453,"company_name":"Lam Research","source":"Existing Database","website_url":null,"logo":null,"industry":null,"address_line_1":null,"address_line_2":null,"is_approved":false,"is_disabled":false,"primary_placecoms":null,"secondary_placecoms":null,"created_by":8526,"updated_by":10660,"created_at":1759823945000,"updated_at":1784608879000},"questions":[],"documents":[{"documentName":null,"jd_document_id":1170,"application_id":1346,"document_id":19538,"user_id":10943,"document_type_id":5,"uuid":"6e142390-8a2a-4b22-9d61-ee5c2e2c3fae","file_name":"JD for Lam Internship","file_original_name":"JD for Lam Internship 5-6-26.docx","file_extension":"docx","file_path":"/datadrive/iisc-files/skynet-v2-files/10943-10943","file_size":"17 KB","file_name_in_path":"1781241204755_JDforLamInternship5-6-26.docx","file_link":"10943-10943/1781241204755_JDforLamInternship5-6-26.docx","is_jd":true,"created_by":10943,"updated_by":10943,"created_at":1781241205000,"updated_at":1781241205000,"document_name":null}],"offer_letter_sample_copy":[],"applicant_status":null,"eligibility_message":"","job_roles":[{"deleted":false,"published":true,"applied":false,"application_job_role_id":1687,"application_id":1346,"job_role_id":1190,"company_id":453,"company_name":"Lam Research","display_name":"Lam Research","job_title":"Engineering Intern 3","job_role_label":"Engineering Intern 3","placement_proc