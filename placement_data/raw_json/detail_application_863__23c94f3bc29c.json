{"status":"success","message":null,"data":{"responsibilities":null,"overview":null,"locations":"Hyderabad","processCompleted":false,"deleted":false,"mailPublished":true,"newCompany":false,"dream":false,"notificationMuted":true,"applied":false,"studentOopsOrFrozen":false,"modifyAllowed":false,"withdrawAllowed":false,"withdrawalDeadlineSameAsApplicationDeadline":false,"displayNameSameAsCompanyName":true,"includedInApplicationMatrix":false,"application_detail_id":4574,"application_id":863,"application_status_id":3,"placement_process_id":44,"batch_group_id":0,"batch_group_ids":"[60, 59]","dayslot_id":0,"cluster_id":0,"cluster_sequence_number":0,"job_function_id":0,"uuid":"307f1253-275e-4318-bfb4-36b947d32522","sector_id":66,"company_id":1190,"max_roles_to_be_applied":null,"company_name":"Silicon Labs","job_title":"RF/Analog Engineer","sector_label":"VLSI and Semiconductors","other_sector":"","max_roles":0,"job_summary":"","job_function":"","job_description":"","process_name":"FT 2025-26","batch_group_label":"","skills":"NA","website_url":"https://www.silabs.com/","eligibility_information":"NA","job_package":"","min_work_experience":0,"max_work_experience":0,"is_dream":false,"date_of_visit":null,"publish_time":1765787145000,"withdrawl_deadline":1765873800000,"application_deadline":1765873800000,"application_start_time":1765787400000,"additional_information":"<b>Why Silicon Labs:<br></b>Innovation doesn't start with companies; it starts with people. We put people first in everything we do, whether it&#8217;s employees we work with every day, our customers developing new devices, or the people in communities where we operate. Our incredibly talented team is comprised of innovative risk-takers pushing the bounds of what&#8217;s possible. We're problem solvers first, addressing industry&#8217;s biggest challenges to transform industries, grow economies and improve lives.<br><br><b>What will you do:</b><br>You&#8217;ll contribute to the design and development of state-of-the-art Wi-Fi/Bluetooth products, focusing on low-power, high-performance RF and analog circuits. You&#8217;ll work closely with senior engineers, learning the full design flow from concept to silicon validation.<br><br><b>Key Responsibilities/Role:<br></b>&#10;&#160;&#8226;&#9;Contribute to the design, simulation, and verification of analog/RF building blocks (LNAs, mixers, baseband filters, dividers, PAs, etc.) in advanced CMOS technologies.<br>&#160;&#8226;&#9;Support integration and characterization of analog/RF sub-systems such as Rx, Tx, and synthesizer blocks.<br>&#160;&#8226;&#9;Perform schematic design, transistor-level simulation, and assist in layout verification and reviews.&#10;&#8226;&#9;Participate in silicon validation and debug, correlating lab measurements with simulations.<br>&#160;&#8226;&#9;Work with cross-functional teams (system, digital, layout, and test engineering) to ensure successful product integration.<br>&#160;&#8226;&#9;Support documentation and review processes for design blocks.<br>&#160;&#8226;&#9;Apply low-power design principles and techniques to meet aggressive power and performance targets.<br><br><b>Preferred Skills</b>:<br>&#160;&#8226;&#9;Experience in Cadence Design Environment for Analog, Mixed-Signal and RF designs (Cadence Virtuoso, SpectreRF, EMX, AFS etc)<br>&#160;&#8226;&#9;Solid understanding of design and analysis of transistor-level low-power analog integrated circuits.&#10;&#8226;&#9;Solid understanding of feedback systems and stability analysis in both time and frequency domains.<br>&#160;&#8226;&#9;Strong fundamentals in digital/analog communication theory, signal processing, electromagnetic theory, digital design concepts<br>&#160;&#8226;&#9;Ability to use tools like Matlab for design and modeling.<br>&#160;&#8226;&#9;Good communication skills and experience in technical documentation.<br>&#160;&#8226;&#9;Basic scripting knowledge in Python, SKILL, Shell, etc. for design automation is desirable.<br>&#160;&#8226;&#9;Good understanding of RF system fundamentals, modulation/demodulation, and wireless transceiver architectures<br>.&#10;&#8226;&#9;Good understanding of device noise, mismatch, linearity, and other RF and analog impairments<br><br><b>Good to have requirements</b> <br>&#160;Academic project/Internship experience that relates to the design of either of the following<br>&#160;&#8226;&#9;WLAN, Bluetooth or any other wireless transceivers/synthesizers, etc.<br>&#160;&#8226;&#9;Power management designs related to LDOs, buck/boost regulators, battery chargers, energy harvesters, etc<br><br><b>Education Requirements</b>:&#10;BS/MS/MSc/Ph. D in Electronics/ Electrical/ Integrated Circuits Engineering<br>","additional_details":null,"is_notification_muted":true,"is_withdrawal_same_as_application_deadline":false,"is_new_company":false,"is_display_name_same_as_company_name":true,"is_included_in_application_matrix":false,"display_name":"Silabs India Pvt Ltd","is_published":true,"is_deleted":false,"is_process_completed":false,"created_by":9859,"created_by_name":"Rajkiran Sreedharan","updated_by":8524,"created_at":1765785566000,"updated_at":1765787145000,"company_query":{"overview":null,"city":null,"state":null,"zip":null,"pan":null,"contacts":null,"sourceHistory":null,"placecoms":null,"approved":false,"company_id":1190,"company_name":"Silicon Labs","source":null,"website_url":null,"logo":null,"industry":null,"address_line_1":null,"address_line_2":null,"is_approved":false,"is_disabled":false,"primary_placecoms":null,"secondary_placecoms":null,"created_by":8524,"updated_by":8524,"created_at":1761120168000,"updated_at":1761120168000},"questions":[],"documents":[{"documentName":null,"jd_document_id":902,"application_id":863,"document_id":15262,"user_id":9859,"document_type_id":5,"uuid":"a2146b21-dc20-4200-88df-6a8be9775b52","file_name":"RF/Analog Engineer","file_original_name":"JD RFIC Engineer-I.docx","file_extension":"docx","file_path":"/datadrive/iisc-files/skynet-v2-files/9859-985