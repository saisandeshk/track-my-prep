{"status":"success","message":null,"data":{"responsibilities":null,"overview":null,"locations":"Bengaluru","processCompleted":false,"deleted":false,"mailPublished":true,"newCompany":false,"dream":false,"notificationMuted":false,"applied":false,"studentOopsOrFrozen":false,"modifyAllowed":false,"withdrawAllowed":false,"withdrawalDeadlineSameAsApplicationDeadline":false,"displayNameSameAsCompanyName":true,"includedInApplicationMatrix":false,"application_detail_id":3993,"application_id":679,"application_status_id":3,"placement_process_id":44,"batch_group_id":0,"batch_group_ids":"[59, 60]","dayslot_id":0,"cluster_id":0,"cluster_sequence_number":0,"job_function_id":0,"uuid":"5f97a027-0322-4cbe-a647-b0739951f48b","sector_id":66,"company_id":1198,"max_roles_to_be_applied":null,"company_name":"Sandisk India Device Design Center","job_title":"Staff Engineer – Packaging Engineer ","sector_label":"VLSI and Semiconductors","other_sector":"","max_roles":0,"job_summary":"","job_function":"","job_description":"","process_name":"FT 2025-26","batch_group_label":"","skills":"•\tStrong oral and written communication skills.\n•\tDemonstrated a strong work ethic.\n•\tAbility to work in a global team environment and interact with other engineers to define and implement experiments and conduct relevant simulations for feasibility and validation of concepts, and provide design solutions to support new package technology development.\n","website_url":"https://www.sandisk.com/en-in/company/about-us","eligibility_information":"PhD in Mechanical Engineering, or M.S. in Mechanical Engineering plus >3 years of relevant industrial experience.\n\nCGPA - 7& Above","job_package":"","min_work_experience":36,"max_work_experience":0,"is_dream":false,"date_of_visit":null,"publish_time":1763464909000,"withdrawl_deadline":1763551800000,"application_deadline":1763551800000,"application_start_time":1763465100000,"additional_information":"ESSENTIAL DUTIES AND RESPONSIBILITIES:&#10;<div>As a Packaging Engineer, you will work in the Packaging R&amp;D group on the modelling and simulation, design of experiments and testing across semiconductor packaging, flash memory product and host levels. &#10;</div><div>&#8226;&#9;Responsible for influencing package and product design by addressing structural integrity and reliability issues and advancing the technology of semiconductor packaging in general. The scope is to address all mechanical aspects of packaging technology, including associated materials and processes. The focus will be on solutions to meet increased demands for small form factors and high-performance packages with thinner chips, more chips, denser interconnects, higher power, and higher reliability.&#10;</div><div>&#8226;&#9;Responsible for the modelling and simulation, design of experiment, and testing, whichever comes first for best engineering practice, of mechanical responses of IC package and flash products, including solid state drives.&#10;</div><div>&#8226;&#9;This position will interface with package &amp; product design, electrical and physical characterization, reliability testing, failure analysis, assembly R&amp;D and other process teams.&#10;</div><div>&#8226;&#9;A solid background in applied mechanics, especially computational and/or experimental solid mechanics, is required. In-depth knowledge of IC packaging is highly desired.&#10;</div><div>Qualifications&#10;</div><div>REQUIRED:&#10;</div><div>&#8226;&#9;PhD in Mechanical Engineering, or M.S. in Mechanical Engineering plus &gt;3 years of relevant industrial experience.&#10;</div><div>&#8226;&#9;Solid knowledge through academic coursework or experience required in mechanical engineering of IC packaging and related areas.&#10;</div><div>&#8226;&#9;Strong background in computational solid mechanics and/or experimental solid mechanics with emphasis on failure analysis and design of experiments.&#10;</div><div>&#8226;&#9;Broad knowledge of mechanical behaviors of various material types, including composite laminates, polymers, and metals (e.g., solder).&#10;</div><div>&#8226;&#9;Working knowledge of designing and conducting mechanical testing and/or using a commercial FEA package.&#10;</div><div>&#8226;&#9;Good understanding of general semiconductor packaging processes, materials, technology, and trends, such as substrate design and manufacturing, moulding, wire-bonding, die attach, flip chip, etc.&#10;</div><div>SKILLS:&#10;</div><div>&#8226;&#9;Strong oral and written communication skills.&#10;</div><div>&#8226;&#9;Demonstrated a strong work ethic.&#10;</div><div>&#8226;&#9;Ability to work in a global team environment and interact with other engineers to define and implement experiments and conduct relevant simulations for feasibility and validation of concepts, and provide design solutions to support new package technology development.</div>","additional_details":"CGPA - 7 &amp; Above","is_notification_muted":false,"is_withdrawal_same_as_application_deadline":false,"is_new_company":false,"is_display_name_same_as_company_name":true,"is_included_in_application_matrix":false,"display_name":"Sandisk India Device Design Center","is_published":true,"is_deleted":false,"is_process_completed":false,"created_by":9876,"created_by_name":"Akanksha Jain","updated_by":8526,"created_at":1761556079000,"updated_at":1763464909000,"company_query":{"overview":null,"city":null,"state":null,"zip":null,"pan":null,"contacts":null,"sourceHistory":null,"placecoms":null,"approved":false,"company_id":1198,"company_name":"Sandisk India Device Design Center","source":"Existing Database","website_url":null,"logo":null,"industry":null,"address_line_1":null,"address_line_2":null,"is_approved":false,"is_disabled":false,"primary_placecoms":null,"secondary_placecoms":null,"created_by":8526,"updated_by":10660,"created_at":1761543571000,"updated_at":1784609793000},"questions":[{"mcqOptions":null,"mcqId":0,"answer":null,"answered":false,"question_id":419,"application_id":679,"question_type_id":1,